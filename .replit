run = "python backend/app.py"
entrypoint = "backend/app.py"
modules = ["python-3.12"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "gunicorn --chdir backend app:app --bind 0.0.0.0:5000 --workers 2 --timeout 180"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80
